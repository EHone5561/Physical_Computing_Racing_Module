{
  "verbose": true,

  "recording": {
    "enabled": true,
    "directory": "practices",
    "interval_s": 0.1,
    "flush_s": 1.0
  },

  "pca9685_address": 95,
  "servo_channel": { "steer": 0, "base": 1, "arm": 2, "wrist": 3, "grip": 4 },
  "servo_pulse_us": [500, 2400],
  "servo_limits": {
    "steer": [60, 120], "base": [0, 180], "arm": [0, 180], "wrist": [0, 180], "grip": [0, 180]
  },
  "steer_center": 90,
  "grip": { "open": 135, "close": 30, "release": 105 },
  "servo_move_time": 0.5,
  "servo_step_s": 0.02,
  "grip_move_s": 0.5,
  "grip_wait_s": 0,

  "motor": {
    "channels": { "m1": [15, 14], "m2": [12, 13] },
    "direction": -1,
    "max_speed": 45,
    "slow_speed": 30,
    "fine_speed": 25,
    "fine_pulse_s": 0.2,
    "max_drive_s": 12.0,
    "kick_speed": 50,
    "kick_s": 0.3,
    "stall_s": 0.6,
    "stall_step": 5,
    "stall_max_extra": 25,
    "boost_brake_cm_per_pct": 0.15
  },

  "sonar": { "trig": 23, "echo": 24, "queue_len": 3, "max_distance_m": 2.0 },
  "sonar_filter": { "jump_cm": 3.0, "window": 3 },
  "stop": {
    "target_cm": 29.3,
    "slow_down_cm": 60.0,
    "brake_margin_cm": 3.0,
    "tolerance_cm": 0.25,
    "settle_s": 0.3,
    "fine_max_tries": 6
  },

  "centering": {
    "gyro": { "address": 104, "axis": "z", "sign": 1, "min_calib_samples": 50 },
    "steer_sign": -1,
    "heading_gain": 2.0,
    "lateral_gain_deg_per_cm": 1.5,
    "lateral_target_cm": 0.0,
    "max_heading_fix_deg": 6,
    "steer_limit_deg": 15,
    "line_pins": { "left": 22, "middle": 27, "right": 17 }
  },

  "run_all": {
    "use_gyro": true,
    "wrist_flip": false,
    "carry_move_s": 0.6,
    "swing_move_s": 0.7,
    "empty_move_dps": 120,
    "reach_adjust": { "arm": 0, "wrist": 0 },
    "place_press": { "arm": 18, "wrist": 18 },
    "place_move_s": 0.4,
    "place_settle_s": 0,
    "release_hold_s": 0,
    "release_by_slot": { "right_back": 180, "left_front": 130 },
    "release_by_slot_reverse": { "right_front": 130, "left_back": 180 },
    "heading_fix_max_deg": 6,
    "confirm": true
  },

  "camera": { "index": 0, "width": 1280, "height": 720, "hfov_deg": 90 },
  "start_qr": { "size_cm": 15, "confirm_frames": 2, "require_blank_first": true, "blank_frames": 3, "max_misses": 3 },

  "look": {
    "use_qr": false,
    "retries": 3,
    "settle_s": 0.2,
    "front_on_image_left": { "left": false, "right": true },
    "default_place": { "left": "front", "right": "back" }
  },

  "poses_reverse": {
    "left_front_above":  { "base": 152, "arm": 159, "wrist": 144 },
    "left_front_down":   { "base": 152, "arm": 180, "wrist": 159 },
    "left_front_carry":  { "base": 152, "arm": 137, "wrist": 150 },
    "right_front_carry": { "base": 18,  "arm": 135, "wrist": 145 },
    "right_front_place": { "base": 18,  "arm": 162, "wrist": 133 },
    "right_back_above":  { "base": 0,   "arm": 132, "wrist": 109 },
    "right_back_down":   { "base": 0,   "arm": 165, "wrist": 131 },
    "right_back_carry":  { "base": 0,   "arm": 100, "wrist": 115 },
    "left_back_carry":   { "base": 180, "arm": 128, "wrist": 130 },
    "left_back_place":   { "base": 180, "arm": 154, "wrist": 135 }
  },

  "poses": {
    "qr_view":           { "base": 90,  "arm": 90,  "wrist": 90 },
    "drive":             { "base": 90,  "arm": 90,  "wrist": 90 },
    "look_left":         { "base": null, "arm": null, "wrist": null },
    "look_right":        { "base": null, "arm": null, "wrist": null },
    "left_front_above":  { "base": null, "arm": null, "wrist": null },
    "left_front_down":   { "base": null, "arm": null, "wrist": null },
    "left_front_carry":  { "base": 162, "arm": 135, "wrist": 145 },
    "left_front_place":  { "base": 162, "arm": 162, "wrist": 133 },
    "left_back_above":   { "base": 180, "arm": 132, "wrist": 109 },
    "left_back_down":    { "base": 180, "arm": 165, "wrist": 131 },
    "left_back_carry":   { "base": 180, "arm": 100, "wrist": 115 },
    "left_back_place":   { "base": null, "arm": null, "wrist": null },
    "right_front_above": { "base": 24 , "arm": 159, "wrist": 144 },
    "right_front_down":  { "base": 24 , "arm": 180, "wrist": 156 },
    "right_front_carry": { "base": 24 , "arm": 137, "wrist": 150 },
    "right_front_place": { "base": null, "arm": null, "wrist": null },
    "right_back_above":  { "base": null, "arm": null, "wrist": null },
    "right_back_down":   { "base": null, "arm": null, "wrist": null },
    "right_back_carry":  { "base": 0  , "arm": 128, "wrist": 130 },
    "right_back_place":  { "base": 0  , "arm": 154, "wrist": 130 }
  }
}
